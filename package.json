{
  "name": "gazette",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared"
  ],
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f",
    "schema:fresh": "docker-compose exec backend pnpx mikro-orm schema:fresh --run",
    "docs:build": "typedoc",
    "docs:build-dev": "typedoc && echo 'Documentation available at /docs'",
    "test:docker": "docker-compose --env-file .env.test -f docker-compose.test.yml up --build --abort-on-container-exit",
    "test:docker:clean": "docker-compose -f docker-compose.test.yml down -v && docker system prune -f",
    "test:docker:logs": "docker-compose -f docker-compose.test.yml logs -f",
    "test": "jest",
    "test:unit": "docker-compose -f docker-compose.test.yml run --rm test-backend && docker-compose -f docker-compose.test.yml run --rm test-frontend",
    "test:backend": "docker-compose -f docker-compose.test.yml run --rm test-backend",
    "test:frontend": "docker-compose -f docker-compose.test.yml run --rm test-frontend",
    "test:e2e": "docker-compose -f docker-compose.test.yml --profile e2e up --build --abort-on-container-exit",
    "test:all": "docker-compose -f docker-compose.test.yml up --build --abort-on-container-exit",
    "test:clean": "docker-compose -f docker-compose.test.yml down -v && docker system prune -f",
    "test:logs": "docker-compose -f docker-compose.test.yml logs -f"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.14.1",
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint-react/eslint-plugin": "^1.52.2",
    "@types/jest": "^29.5.14",
    "babel-jest": "^30.0.5",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "ts-jest": "^29.4.0",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.4.5",
    "varvara-typedoc-theme": "^0.3.6"
  }
}
